NODE_ENV=development
PORT=4000
# En producción usa la URL pública exacta del frontend (ej. https://app.tudominio.com)
FRONTEND_URL=http://localhost:5173

# MongoDB
# Paste your Atlas connection string only in backend/.env or your hosting provider's
# encrypted environment variables. Never commit a real connection string.
MONGODB_URI=
# Optional: allows the local demo fallback only outside production.
MONGODB_MEMORY_FALLBACK=true

# Redis (opcional — fallback a Map() si no está disponible)
REDIS_URL=

# JWT RS256 — rutas a claves PEM (o contenido inline)
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Cifrado de campos sensibles (32 bytes en hex)
FIELD_ENCRYPTION_KEY=replace_with_64_hex_chars_from_openssl_rand_hex_32

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Canela Coach <noreply@canelacoach.com>"

# WhatsApp Business API (opcional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEFAULT=claude-3-5-haiku-20241022
ANTHROPIC_MODEL_ESCALADO=claude-3-5-sonnet-20241022

# OpenAI Whisper (voz)
OPENAI_API_KEY=

# Sentry (opcional)
SENTRY_DSN=

# Seed credentials
SEED_ADMIN_EMAIL=admin@canelacoach.com
SEED_ADMIN_PASSWORD=CanelaAdmin2026!
SEED_ENTRENADOR_EMAIL=entrenador@canelacoach.com
SEED_ENTRENADOR_PASSWORD=CanelaCoach2026!
